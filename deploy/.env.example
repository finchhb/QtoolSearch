# Пример переменных окружения для боевого запуска (public). Скопируйте в .env рядом с app.py
# и заполните своими значениями. Файл .env НЕ коммитится.

# local — запуск на ПК (loopback, админка без токена), public — сайт (админка только по ADMIN_TOKEN)
ADVISOR_MODE=public
ADVISOR_HOST=127.0.0.1
PORT=8000

# Обязателен в public-режиме и для доступа к админке по сети. Длинная случайная строка.
ADMIN_TOKEN=change-me

# Домены сайта для CORS и iframe (через запятую)
ALLOWED_ORIGINS=https://qtool.ru,https://www.qtool.ru

# Лимит запросов с одного IP в минуту
RATE_LIMIT_PER_MIN=20
# За nginx: брать IP клиента из X-Forwarded-For (принимается только от локального прокси)
TRUST_PROXY=1

# Автообновление прайсов, часы (0 — выключено)
ADVISOR_SYNC_HOURS=24

# Пересчёт валют в рубли по курсу ЦБ (по умолчанию выключен, см. README)
ADVISOR_CONVERT_FX=0

# --- LLM-верификатор (необязательно) ---
# Ключ в public-режиме задаётся ТОЛЬКО здесь, в data/llm_config.json он не пишется.
LLM_BASE_URL=https://foundation-models.api.cloud.ru/v1
LLM_API_KEY=
LLM_MODELS=gpt-oss-120b
# Общий дедлайн одной проверки, секунды, и потолок выходных токенов
LLM_TIMEOUT=90
LLM_MAX_TOKENS=250
# Выключить проверку: ADVISOR_DISABLE_LLM=1 (или REVIEW_ENABLED=0)
ADVISOR_DISABLE_LLM=0
REVIEW_ENABLED=1
# Доля контрольных проверок обычных запросов
AUDIT_SAMPLE_RATE=0.15
REVIEW_MAX_PER_HOUR=60
REVIEW_MAX_PER_DAY=300
