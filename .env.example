# QtoolSearch — переменные окружения для Docker Compose.
# Скопируйте в .env (cp .env.example .env) и заполните своими значениями. Файл .env НЕ коммитится.

# ===== Общие =====
# Длинная случайная строка — защищает POST /admin/reload.
ADMIN_SECRET=change-me-to-a-long-random-string
# Домены сайта для CORS/iframe (через запятую).
ALLOWED_ORIGINS=https://qtool.ru,https://www.qtool.ru
# Лимит запросов с одного IP в минуту (0 — без лимита).
RATE_LIMIT_PER_MIN=60
# За nginx/Caddy: брать IP клиента из X-Forwarded-For.
TRUST_PROXY=1

# ===== Backend API (api.py) =====
API_HOST=0.0.0.0
API_PORT=8000

# ===== Streamlit-виджет (app_streamlit.py) =====
# Куда ходит виджет за подбором (имя сервиса api в docker-compose).
API_BASE_URL=http://api:8000
APP_TITLE=QtoolSearch — подбор аналогов

# ===== MAX-бот (bot_max.py) =====
# Токен бота из business.max.ru (Чат-боты → Настройки).
MAX_BOT_TOKEN=
# polling (по умолчанию, без домена/SSL) или webhook (для production).
BOT_MODE=polling
# Домен MAX Bot API (по умолчанию актуальный platform-api2.max.ru).
MAX_API_BASE=https://platform-api2.max.ru
# Публичный адрес виджета/сайта для кнопок бота.
SITE_URL=https://qtool.ru
# ID рабочего чата менеджеров в MAX (куда пересылать заявки на счёт).
MANAGER_CHAT_ID=
# Email отдела продаж (если настроен SMTP).
MANAGER_EMAIL=
# Секрет для проверки webhook-запросов (при BOT_MODE=webhook).
WEBHOOK_SECRET=
# Порт приёма webhook внутри контейнера.
BOT_WEBHOOK_PORT=8080

# ===== Почта для заявок (необязательно) =====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@qtool.ru

# ===== Каталог =====
# 1 — не ходить в сеть при старте (использовать локальные data/*.csv).
SKIP_NETWORK_SYNC=0
SKIP_RINSCOM_SYNC=1