+def _build_index(rows: List[Dict[str, str]]) -> Dict[str, Any]:
+    """TF-IDF РІРµРєС‚РѕСЂС‹ РїСЂРёРјРµСЂРѕРІ: РѕРґРёРЅ СЂР°Р· РЅР° РІРµСЂСЃРёСЋ С„Р°Р№Р»Р°, Р° РЅРµ РЅР° РєР°Р¶РґС‹Р№ Р·Р°РїСЂРѕСЃ."""
+    docs = [_tokenize(r["query"]) for r in rows]
+    df: Dict[str, int] = {}
+    for toks in docs:
+        for t in set(toks):
+            df[t] = df.get(t, 0) + 1
+    n = len(rows)
+    vecs = []
+    for toks in docs:
+        tf: Dict[str, int] = {}
+        for t in toks:
+            tf[t] = tf.get(t, 0) + 1
+        v = {t: c * (math.log(n / df[t]) + 1.0) for t, c in tf.items()}
+        norm = math.sqrt(sum(x * x for x in v.values())) or 1.0
+        vecs.append({t: x / norm for t, x in v.items()})
+    return {"df": df, "vecs": vecs, "n": n}
+
