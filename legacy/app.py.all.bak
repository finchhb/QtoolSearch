"""
app.py - веб-сервер подбора токарных пластин (v7).

Основной движок — внутренний парсер (src/engine.py). LLM (любой OpenAI-совместимый API: Yandex AI Studio, Cloud.ru, MWS, своя модель) — только проверяющий (src/reviewer.py).
Режимы (переменная окружения ADVISOR_MODE):
  local  (по умолчанию) — запуск на ПК, слушает 127.0.0.1, админка открыта с этого же компьютера.
  public — для сайта: админка только по ADMIN_TOKEN, ключ LLM только из LLM_API_KEY, ничего не пишется в конфиг.
Остальные настройки: ADVISOR_HOST, PORT, ADMIN_TOKEN, ALLOWED_ORIGINS (через запятую, для CORS и iframe),
RATE_LIMIT_PER_MIN (по умолчанию 20 запросов с одного IP), TRUST_PROXY=1 (брать IP из X-Forwarded-For за nginx),
ADVISOR_SYNC_HOURS (автообновление прайса qtool.ru, 0 = выкл), AUDIT_SAMPLE_RATE, REVIEW_MAX_PER_HOUR, REVIEW_MAX_PER_DAY, REVIEW_ENABLED;
LLM: LLM_API_KEY, LLM_BASE_URL, LLM_MODELS, LLM_TIMEOUT (см. src/llm_client.py).
"""
import base64
import hashlib
import hmac
import http.server
import json
import os
import re
import socketserver
import sys
import threading
import time
import urllib.parse
import webbrowser
from collections import deque
from typing import Any, Dict, Optional

from src.llm_client import load_env_file

load_env_file()  # .env читаем ДО остальных модулей: от него зависят режим, токен и фильтры

from src.engine import ToolAdvisorEngine  # noqa: E402
from src import training  # noqa: E402
from src.materials_mapping import detect_iso_group  # noqa: E402
from src.ui import ADMIN_HTML, CHAT_HTML  # noqa: E402

MODE = os.environ.get("ADVISOR_MODE", "local").lower()
PUBLIC = MODE == "public"
HOST = os.environ.get("ADVISOR_HOST", "127.0.0.1")
PORT = int(os.environ.get("PORT", "8000"))
ADMIN_TOKEN = os.environ.get("ADMIN_TOKEN", "")
ALLOWED_ORIGINS = {o.strip().rstrip("/") for o in os.environ.get("ALLOWED_ORIGINS", "").split(",") if o.strip()}
RATE_LIMIT = int(os.environ.get("RATE_LIMIT_PER_MIN", "20"))
TRUST_PROXY = os.environ.get("TRUST_PROXY", "0") == "1"
SYNC_HOURS = float(os.environ.get("ADVISOR_SYNC_HOURS", "0"))
MAX_QUERY_LEN = 500
MAX_BODY = 1 * 1024 * 1024
MAX_UPLOAD = 30 * 1024 * 1024

DATA_DIR = os.path.join(os.path.dirname(os.path.abspath(__file__)), "data")
EVAL_FILE = os.path.join(DATA_DIR, "evaluations.jsonl")
CUSTOM_INSTRUCTIONS_FILE = os.path.join(DATA_DIR, "custom_instructions.txt")
INSERT_CODE_RE = re.compile(r"\b[CWTDSVR][NCTBPEFG][MGU][A-Z]\s?\d{4,6}\b")

engine: Optional[ToolAdvisorEngine] = None


# --------------------------------------------------------------------------------------------------
# Сессии и лимит запросов
# --------------------------------------------------------------------------------------------------
class Sessions:
    """Контекст диалога отдельно для каждого посетителя (раньше история была общей на всех)."""

    def __init__(self, ttl: int = 2 * 3600, cap: int = 3000):
        self.ttl, self.cap = ttl, cap
        self._d: Dict[str, Dict[str, Any]] = {}
        self._lock = threading.Lock()

    def get(self, sid: str) -> Dict[str, Any]:
        with self._lock:
            s = self._d.get(sid)
            if s and time.time() - s["ts"] < self.ttl:
                return dict(s)
            return {}

    def put(self, sid: str, **data: Any) -> None:
        with self._lock:
            if len(self._d) >= self.cap:
                now = time.time()
                old = [k for k, v in self._d.items() if now - v["ts"] > self.ttl]
                for k in (old or list(self._d)[: self.cap // 4]):
                    self._d.pop(k, None)
            self._d[sid] = {"ts": time.time(), **data}

    def clear(self, sid: str) -> None:
        with self._lock:
            self._d.pop(sid, None)


class RateLimiter:
    def __init__(self, per_min: int):
        self.per_min = per_min
        self._hits: Dict[str, deque] = {}
        self._lock = threading.Lock()

    def allow(self, key: str) -> bool:
        if self.per_min <= 0:
            return True
        now = time.time()
        with self._lock:
            q = self._hits.setdefault(key, deque())
            while q and now - q[0] > 60:
                q.popleft()
            if len(q) >= self.per_min:
                return False
            q.append(now)
            if len(self._hits) > 20000:
                self._hits.clear()
            return True


SESSIONS = Sessions()
LIMITER = RateLimiter(RATE_LIMIT)


def build_engine() -> ToolAdvisorEngine:
    global engine
    auto_sync = (
        not os.path.exists("data/catalog_qtool.csv")
        and not os.path.exists("data/catalog_rinscom.csv")
        and os.environ.get("SKIP_RINSCOM_SYNC") != "1"
    )
    engine = ToolAdvisorEngine(auto_sync_rinscom=auto_sync)
    if os.path.exists(CUSTOM_INSTRUCTIONS_FILE):
        try:
            with open(CUSTOM_INSTRUCTIONS_FILE, "r", encoding="utf-8") as f:
                txt = f.read().strip()
            if txt:
                engine.set_custom_instructions(txt)
        except Exception as e:
            print(f"Ошибка чтения custom_instructions.txt: {e}")

    def _sync_loop():
        if os.environ.get("SKIP_NETWORK_SYNC") == "1":
            return
        first = True
        while True:
            if SYNC_HOURS > 0 or (first and not PUBLIC):
                try:
                    ok, msg, _ = engine.sync_all()
                    print(f"[Автообновление обеих таблиц] {msg}" if ok else f"[Автообновление обеих таблиц] не удалось: {msg}")
                except Exception as e:
                    print(f"[Автообновление прайса qtool.ru] ошибка: {e}")
            first = False
            if SYNC_HOURS <= 0:
                return
            time.sleep(SYNC_HOURS * 3600)

    threading.Thread(target=_sync_loop, daemon=True).start()
    return engine


def effective_query(sid: str, q: str) -> str:
    """Короткий ответ на уточняющий вопрос («чистовая», «наружная») дополняет предыдущий запрос этой же сессии."""
    prev = SESSIONS.get(sid)
    if not prev or not prev.get("last_q"):
        return q
    words = len(re.findall(r"\w+", q))
    if words > 8 or INSERT_CODE_RE.search(q.upper()) or re.search(r"аналог|замен|кросс|вместо", q.lower()):
        return q
    if prev.get("decision") == "clarification_branch" or not detect_iso_group(q):
        return (prev["last_q"] + ". " + q)[: MAX_QUERY_LEN * 2]
    return q


def public_result(res: Dict[str, Any]) -> Dict[str, Any]:
    """Наружу отдаём только нужное для показа — без внутренних аргументов поиска и служебных полей."""
    keep = ("sku", "name", "brand", "grade", "iso_group", "stock", "price_display", "price_on_request", "shop_links_markdown", "in_both_stores")
    prods = [{k: p.get(k) for k in keep if k in p} for p in ((res.get("tool_result") or {}).get("products") or [])[:6]]
    out_parsed = {"parsed": res.get("parsed")} if not PUBLIC else {}
    return {
        **out_parsed,
        "response_text": res.get("response_text", ""),
        "decision": res.get("decision"),
        "llm_checked": bool(res.get("llm_checked")),
        "llm_status": res.get("llm_status", "not_needed"),
        "tool_result": {"products": prods},
    }


# --------------------------------------------------------------------------------------------------
# HTTP
# --------------------------------------------------------------------------------------------------
class AdvisorHTTPHandler(http.server.BaseHTTPRequestHandler):
    timeout = 120
    server_version = "ToolAdvisor/7"
    sys_version = ""

    def log_message(self, format, *args):  # noqa: A002
        pass

    def _ip(self) -> str:
        if TRUST_PROXY:
            xff = self.headers.get("X-Forwarded-For", "")
            if xff:
                return xff.split(",")[-1].strip()[:64]
        return self.client_address[0]

    def _origin_ok(self) -> Optional[str]:
        o = (self.headers.get("Origin") or "").rstrip("/")
        return o if o and o in ALLOWED_ORIGINS else None

    def _headers(self, code: int, ctype: str, extra: Optional[Dict[str, str]] = None) -> None:
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Referrer-Policy", "no-referrer")
        o = self._origin_ok()
        if o:
            self.send_header("Access-Control-Allow-Origin", o)
            self.send_header("Vary", "Origin")
        for k, v in (extra or {}).items():
            self.send_header(k, v)

    def _json(self, obj: Dict[str, Any], code: int = 200) -> None:
        data = json.dumps(obj, ensure_ascii=False).encode("utf-8")
        self._headers(code, "application/json; charset=utf-8", {"Cache-Control": "no-store", "Content-Length": str(len(data))})
        self.end_headers()
        self.wfile.write(data)

    def _html(self, html: str) -> None:
        data = html.encode("utf-8")
        anc = " ".join(["'self'"] + sorted(ALLOWED_ORIGINS))
        csp = f"default-src 'self'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; img-src 'self' data:; frame-ancestors {anc}"
        self._headers(200, "text/html; charset=utf-8", {"Content-Security-Policy": csp, "Cache-Control": "no-store", "Content-Length": str(len(data))})
        self.end_headers()
        self.wfile.write(data)

    def _body(self, limit: int = MAX_BODY) -> Optional[Dict[str, Any]]:
        try:
            length = int(self.headers.get("Content-Length") or 0)
        except ValueError:
            length = -1
        if length < 0 or length > limit:
            self._json({"error": "Слишком большой запрос"}, 413)
            return None
        raw = self.rfile.read(length).decode("utf-8", errors="replace") if length else ""
        try:
            body = json.loads(raw) if raw else {}
            if not isinstance(body, dict):
                raise ValueError
            return body
        except ValueError:
            self._json({"error": "Некорректный JSON"}, 400)
            return None

    def _admin_ok(self) -> bool:
        tok = self.headers.get("X-Admin-Token", "")
        if ADMIN_TOKEN:
            return hmac.compare_digest(tok.encode(), ADMIN_TOKEN.encode())
        return (not PUBLIC) and self.client_address[0] in ("127.0.0.1", "::1")

    @staticmethod
    def _sid(body: Dict[str, Any], fallback: str) -> str:
        s = re.sub(r"[^A-Za-z0-9_-]", "", str(body.get("session_id") or ""))[:64]
        return s or fallback

    def do_OPTIONS(self):
        self._headers(204, "text/plain", {"Access-Control-Allow-Methods": "GET, POST, OPTIONS", "Access-Control-Allow-Headers": "Content-Type, X-Admin-Token", "Access-Control-Max-Age": "600"})
        self.end_headers()

    def do_GET(self):
        path = urllib.parse.urlparse(self.path).path
        if path in ("/", "/index.html"):
            return self._html(CHAT_HTML)
        if path == "/admin":
            return self._html(ADMIN_HTML)
        if path == "/healthz":
            return self._json({"ok": True})
        if path == "/api/status":
            st = engine.get_catalog_stats()
            try:
                updated = time.strftime("%d.%m.%Y %H:%M", time.localtime(os.path.getmtime(engine.search_engine.catalog_path)))
            except OSError:
                updated = ""
            out = {"total": st["total"], "in_stock": st["in_stock"], "catalog_updated": updated}
            if not PUBLIC:  # кнопки настроек в шапке чата видны только при локальном запуске
                out["local_admin"] = True
                out["llm_on"] = bool(engine.llm.is_configured() and engine.reviewer.enabled)
            return self._json(out)
        if path == "/api/admin/status":
            if not self._admin_ok():
                return self._json({"error": "Нужен админ-токен"}, 403)
            return self._json(self._admin_status())
        if path in ("/api/admin/training", "/api/admin/training.csv"):
            if not self._admin_ok():
                return self._json({"error": "Нужен админ-токен"}, 403)
            if path.endswith(".csv"):
                try:
                    data = open(training.PATH, "rb").read()
                except OSError:
                    data = ("\ufeff" + ";".join(training.FIELDS) + "\r\n").encode("utf-8")
                self._headers(200, "text/csv; charset=utf-8", {"Content-Disposition": "attachment; filename=training_examples.csv", "Content-Length": str(len(data))})
                self.end_headers()
                self.wfile.write(data)
                return
            return self._json({"examples": training.list_examples(100), "count": training.count()})
        self._json({"error": "Не найдено"}, 404)

    def do_POST(self):
        path = urllib.parse.urlparse(self.path).path
        if path.startswith("/api/admin/"):
            if not self._admin_ok():
                return self._json({"error": "Нужен админ-токен" if (PUBLIC or ADMIN_TOKEN) else "Админка доступна только с этого компьютера"}, 403)
            body = self._body(MAX_UPLOAD * 2 if path.endswith("upload_xlsx") else MAX_BODY)
            if body is None:
                return
            return self._admin_post(path[len("/api/admin/"):], body)

        body = self._body()
        if body is None:
            return
        ip = self._ip()

        if path == "/api/query":
            if not LIMITER.allow(ip):
                return self._json({"error": "Слишком много запросов. Подождите минуту."}, 429)
            q = str(body.get("query", "")).strip()
            if not q or len(q) > MAX_QUERY_LEN:
                return self._json({"error": f"Запрос должен быть от 1 до {MAX_QUERY_LEN} символов"}, 400)
            sid = self._sid(body, hashlib.sha1(ip.encode()).hexdigest()[:16])
            eff = effective_query(sid, q)
            try:
                res = engine.process_query(eff)
            except Exception as e:  # парсер не должен ронять сервер
                print(f"[query error] {e!r} :: {q!r}")
                return self._json({"error": "Не удалось обработать запрос. Попробуйте переформулировать."}, 500)
            SESSIONS.put(sid, last_q=eff, decision=res.get("decision"))
            return self._json(public_result(res))

        if path == "/api/clear_chat":
            SESSIONS.clear(self._sid(body, hashlib.sha1(ip.encode()).hexdigest()[:16]))
            return self._json({"status": "cleared"})

        if path == "/api/feedback":
            if not LIMITER.allow("fb:" + ip):
                return self._json({"error": "Слишком много запросов"}, 429)
            rating = str(body.get("rating", ""))
            if rating not in ("like", "warn", "dislike"):
                return self._json({"error": "Некорректная оценка"}, 400)
            rec = {
                "ts": time.strftime("%Y-%m-%d %H:%M:%S"),
                "sid": hashlib.sha1(self._sid(body, ip).encode()).hexdigest()[:10],
                "rating": rating,
                "comment": str(body.get("comment", ""))[:400],
                "query": str(body.get("query", ""))[:MAX_QUERY_LEN],
                "answer": str(body.get("answer", ""))[:3000],
                "meta": body.get("meta") if isinstance(body.get("meta"), dict) else {},
            }
            os.makedirs(DATA_DIR, exist_ok=True)
            with open(EVAL_FILE, "a", encoding="utf-8") as f:
                f.write(json.dumps(rec, ensure_ascii=False) + "\n")
            return self._json({"status": "saved"})

        self._json({"error": "Не найдено"}, 404)

    def _admin_status(self) -> Dict[str, Any]:
        from src import rates
        llm = engine.llm
        log_tail, fb = [], {"like": 0, "warn": 0, "dislike": 0}
        try:
            with open(os.path.join(DATA_DIR, "review_log.jsonl"), "r", encoding="utf-8") as f:
                log_tail = [json.loads(x) for x in f.read().splitlines()[-12:]]
        except Exception:
            pass
        try:
            with open(EVAL_FILE, "r", encoding="utf-8") as f:
                for line in f:
                    r = json.loads(line).get("rating")
                    if r in fb:
                        fb[r] += 1
        except Exception:
            pass
        rv = engine.reviewer
        unrec = []
        try:
            with open(os.path.join(DATA_DIR, "unrecognized_queries.jsonl"), "r", encoding="utf-8") as f:
                unrec = [json.loads(x)["query"] for x in f.read().splitlines()[-15:]]
        except Exception:
            pass
        return {
            "status": {
                "mode": MODE, "training_examples": training.count(), "catalog": engine.get_catalog_stats(), "rates_date": rates.rates_date() or "нет данных",
                "custom_instructions": engine.custom_instructions,
                "llm": {"configured": llm.is_configured(), "base_url": llm.base_url, "models": llm.models, "last_model": llm.last_model,
                        "last_error": llm.last_error, "enabled": rv.enabled, "sample_rate": rv.sample_rate,
                        "used_last_24h": rv.usage_today(), "max_per_day": rv.max_per_day, "max_per_hour": rv.max_per_hour},
            },
            "review": {"stats": rv.stats, "feedback": fb, "last_reviews": log_tail, "unrecognized_last": unrec},
        }

    def _admin_post(self, action: str, body: Dict[str, Any]) -> None:
        try:
            if action == "llm":
                try:
                    engine.llm.save_config(str(body.get("api_key", "")), str(body.get("base_url", "")), str(body.get("models", "")))
                except PermissionError as e:
                    return self._json({"ok": False, "message": str(e)})
                ok, msg = engine.llm.ping()
                return self._json({"ok": ok, "message": msg})
            if action == "sync_all":
                ok, msg, _ = engine.sync_all()
                return self._json({"ok": ok, "message": msg})
            if action == "train_add":
                q = str(body.get("query", "")).strip()
                if not q:
                    return self._json({"ok": False, "message": "Пустой запрос"})
                parsed = body.get("parsed") if isinstance(body.get("parsed"), dict) else {}
                ex = training.add_example(q, str(body.get("correct_iso", "")), str(body.get("correct_operation", "")),
                                          str(body.get("correct_skus", "")), str(body.get("comment", "")), parsed)
                if not (ex["correct_iso"] or ex["correct_operation"] or ex["correct_skus"] or ex["comment"]):
                    training.delete_example(ex["id"])
                    return self._json({"ok": False, "message": "Заполните хотя бы одно поле: группу ISO, вид обработки, артикулы или комментарий"})
                suggested = training.suggest_tokens(q) if ex["correct_iso"] and ex["correct_iso"] != (parsed.get("iso") or "") else []
                return self._json({"ok": True, "id": ex["id"], "suggested": suggested, "iso": ex["correct_iso"],
                                   "message": f"Сохранено в таблицу (пример №{ex['id']}, всего {training.count()})"})
            if action == "train_delete":
                return self._json({"ok": training.delete_example(str(body.get("id", ""))), "message": "Пример удалён"})
            if action == "train_rules":
                toks = [str(t) for t in (body.get("tokens") or [])][:20]
                n = training.add_material_rules(toks, str(body.get("iso", "")), "добавлено по примеру технолога")
                return self._json({"ok": n > 0, "message": f"Добавлено правил материалов: {n}" if n else "Правила не добавлены (уже есть или не выбраны)"})
            if action == "train_test":
                q = str(body.get("query", "")).strip()[:MAX_QUERY_LEN]
                res = engine.process_query(q, force_local=True)
                return self._json({"ok": True, "message": "Готово", "parsed": res.get("parsed"), "response_text": res.get("response_text", ""),
                                   "decision": res.get("decision")})
            if action == "source":
                ok, msg, _ = engine.switch_source(str(body.get("source", "qtool")))
                return self._json({"ok": ok, "message": msg})
            if action == "sync_qtool":
                ok, msg, _ = engine.sync_price_from_qtool()
                return self._json({"ok": ok, "message": msg})
            if action == "sync_rinscom":
                ok, msg, _ = engine.sync_price_from_rinscom()
                return self._json({"ok": ok, "message": msg})
            if action == "upload_xlsx":
                name = os.path.basename(str(body.get("filename", "price.xlsx")))
                if not name.lower().endswith(".xlsx"):
                    return self._json({"ok": False, "message": "Нужен файл .xlsx"})
                raw = base64.b64decode(str(body.get("content_base64", "")), validate=False)
                if len(raw) > MAX_UPLOAD:
                    return self._json({"ok": False, "message": "Файл больше 30 МБ"})
                ok, msg, _ = engine.load_custom_xlsx_bytes(raw, filename=name)
                return self._json({"ok": ok, "message": msg})
            if action == "prompt":
                txt = str(body.get("custom_instructions", "")).strip()[:4000]
                engine.set_custom_instructions(txt)
                os.makedirs(DATA_DIR, exist_ok=True)
                with open(CUSTOM_INSTRUCTIONS_FILE, "w", encoding="utf-8") as f:
                    f.write(txt)
                return self._json({"ok": True, "message": "Правила сохранены"})
        except Exception as e:
            return self._json({"ok": False, "message": f"Ошибка: {e}"})
        self._json({"error": "Неизвестное действие"}, 404)


class ThreadedServer(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads = True
    allow_reuse_address = True
    request_queue_size = 64


def main() -> None:
    if PUBLIC and not ADMIN_TOKEN:
        print("[!] ADVISOR_MODE=public без ADMIN_TOKEN: админка отключена (это нормально, если она не нужна).")
    build_engine()
    httpd = None
    bound = PORT
    for cand in range(PORT, PORT + (1 if PUBLIC else 30)):
        try:
            httpd = ThreadedServer((HOST, cand), AdvisorHTTPHandler)
            bound = cand
            break
        except OSError:
            continue
    if httpd is None:
        print(f"[ОШИБКА] Не удалось занять порт {PORT} на {HOST}")
        try:
            input("Нажмите Enter для закрытия...")
        except Exception:
            pass
        sys.exit(1)

    st = engine.get_catalog_stats()
    llm = engine.llm
    print("=" * 68)
    print(f"  Подбор токарных пластин v8.4 | режим: {MODE} | движок: внутренний парсер")
    print(f"  Проверка LLM: {'включена (' + llm.model + ')' if (llm.is_configured() and engine.reviewer.enabled) else 'выключена (нет LLM_API_KEY) — отвечает только парсер'}")
    print(f"  База: {st['source_label']} | позиций: {st['total']} | в наличии: {st['in_stock']}")
    print(f"  Адрес: http://localhost:{bound}   Админка: /admin")
    print("=" * 68)
    if not PUBLIC:
        try:
            webbrowser.open(f"http://localhost:{bound}")
        except Exception:
            pass
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        print("\nСервер остановлен.")
        httpd.server_close()


if __name__ == "__main__":
    main()
