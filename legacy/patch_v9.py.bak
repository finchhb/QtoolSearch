                if not (ex["correct_iso"] or ex["correct_operation"] or ex["correct_skus"] or ex["comment"]
                        or ex["correct_shape"] or ex["correct_size"] or ex["correct_radius"]):'''),
    ('app.py', '''"Заполните хотя бы одно поле: группу ISO, вид обработки, артикулы или комментарий"''', '''"Заполните хотя бы одно поле: группу ISO, вид обработки, геометрию, размер, радиус, артикулы или комментарий"'''),
    ('src/llm_client.py', '''    def is_configured(self) -> bool:
        return bool(self.api_key and self.models and self.base_url)''', '''    def is_configured(self) -> bool:
        if not (self.api_key and self.models and self.base_url):
            return False
        if "ваш_ключ" in self.api_key.lower() or "your-" in self.base_url:
            return False  # заглушка из data/llm_config.json — не считаем настроенным
        return True'''),
    ('src/hybrid_search.py', '''            insert_iso_code = re.sub(r"\\s+", "", insert_iso_code.upper())''', '''            from src.iso1832 import norm_code
            insert_iso_code = re.sub(r"\\s+", "", norm_code(insert_iso_code))'''),
    ('src/hybrid_search.py', '''        matches.sort(key=lambda m: (m["score"], m["item"].get("stock", 0)), reverse=True)''', '''        did_you_mean: List[str] = []
        if not matches and filters.get("insert_iso_code"):
            did_you_mean = [c for c, _ in self._fuzzy_codes(filters["insert_iso_code"])]

        matches.sort(key=lambda m: (m["score"], m["item"].get("stock", 0)), reverse=True)'''),
    ('src/hybrid_search.py', '''            "products": top_items,
        }''', '''            "products": top_items,
            "did_you_mean": did_you_mean,
        }'''),
    ('src/hybrid_search.py', '''    def _filter_and_score(self, f: Dict[str, Any], query_tokens: List[str], allow_secondary_iso: bool = False) -> List[Dict[str, Any]]:''', '''    @staticmethod
    def _grams(s: str, n: int = 3):
        from collections import Counter
        s = f"  {s.lower()}  "
        return Counter(s[i:i + n] for i in range(len(s) - n + 1))

    def _fuzzy_codes(self, code: str, k: int = 5):
        """Векторный поиск похожих кодов: символьные 3-граммы + косинусная близость (без LLM)."""
        from src.iso1832 import norm_code
        if getattr(self, "_cg_src", None) is not self.catalog:
            self._cg_src = self.catalog
            self._code_grams = {}
            for it in self.catalog:
                c = it.get("_code_up") or ""
                if c and c not in self._code_grams:
                    self._code_grams[c] = self._grams(c)
        qg = self._grams(norm_code(code))
        qn = math.sqrt(sum(v * v for v in qg.values())) or 1.0
        out = []
        for c, g in self._code_grams.items():
            num = sum(v * qg.get(t, 0) for t, v in g.items())
            den = (math.sqrt(sum(v * v for v in g.values())) or 1.0) * qn
            sim = num / den
            if sim >= 0.6:
                out.append((c, sim))
        return sorted(out, key=lambda x: -x[1])[:k]

    def _filter_and_score(self, f: Dict[str, Any], query_tokens: List[str], allow_secondary_iso: bool = False) -> List[Dict[str, Any]]:'''),
    ('src/ui.py', '''  <input id="q" maxlength="500" placeholder="Например: чистовое точение нержавейки 12Х18Н10Т, CNMG 120408" required>''', '''  <textarea id="q" rows="2" maxlength="4000" style="resize:vertical;font:inherit" placeholder="Например: CNMG 120408 10 шт; WNMG 080408 5 шт. Можно несколько позиций — каждая с новой строки (Shift+Enter — перенос)" required></textarea>'''),
    ('src/ui.py', '''$("f").onsubmit = e => { e.preventDefault(); const t = $("q").value.trim(); if (!t) return; $("q").value = ""; ask(t); };''', '''$("f").onsubmit = e => { e.preventDefault(); const t = $("q").value.trim(); if (!t) return; $("q").value = ""; ask(t); };
$("q").addEventListener("keydown", e => { if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); $("f").requestSubmit(); } });'''),
    ('src/ui.py', OPL, OPL + '\n' + "const SHAPE_OPT = '" + SO + "';" + '\n' + "const RAD_OPT = '" + RO + "';"),
    ('src/ui.py', '''    '<div class="grid"><div>Правильная группа ISO<select class="ti">' + ISO_OPT + '</select></div><div>Правильный вид обработки<select class="to">' + OP_OPT + '</select></div></div>' +''', '''    '<div class="grid"><div>Правильная группа ISO<select class="ti">' + ISO_OPT + '</select></div><div>Правильный вид обработки<select class="to">' + OP_OPT + '</select></div></div>' +
    '<div class="grid"><div>Геометрия (форма)<select class="tsh">' + SHAPE_OPT + '</select></div><div>Размер (код кромки)<input class="tz" maxlength="2" placeholder="напр. 12 (из CNMG12…)"></div><div>Радиус вершины, мм<select class="tr">' + RAD_OPT + '</select></div></div>' +'''),
    ('src/ui.py', '''    const body = { query, correct_iso: g(".ti").value, correct_operation: g(".to").value, correct_skus: g(".ts").value, comment: g(".tc").value, parsed: p };''', '''    const body = { query, correct_iso: g(".ti").value, correct_operation: g(".to").value, correct_shape: g(".tsh").value, correct_size: g(".tz").value, correct_radius: g(".tr").value, correct_skus: g(".ts").value, comment: g(".tc").value, parsed: p };'''),
    ('src/ui.py', '''    '<div class="hint">Парсер понял: ISO ' + (p.iso || "не определено") + ', обработка ' + (p.operation || "не указана") + (p.shape ? ", форма " + p.shape : "") + (p.size ? ", размер " + p.size : "") + (p.code ? ", код " + p.code : "") + '.</div>' +''', '''    '<div class="hint">Парсер понял: ISO ' + (p.iso || "не определено") + ', обработка ' + (p.operation || "не указана") + (p.shape ? ", форма " + p.shape : "") + (p.size ? ", размер " + p.size : "") + (p.radius != null ? ", радиус " + p.radius : "") + (p.code ? ", код " + p.code : "") + '.</div>' +'''),
    ('src/ui.py', ADM, ADM + '\n<div class="row"><div><label>Геометрия (форма)</label><select id="tshape">' + SO + '</select></div>\n<div><label>Размер (код кромки)</label><input id="tsize" maxlength="2" placeholder="напр. 12"></div>\n<div><label>Радиус вершины, мм</label><select id="trad">' + RO + '</select></div></div>'),
    ('src/ui.py', '''{query:q,correct_iso:v("tiso"),correct_operation:v("top"),correct_skus:v("tsk"),comment:v("tcm"),parsed:LASTP}''', '''{query:q,correct_iso:v("tiso"),correct_operation:v("top"),correct_shape:v("tshape"),correct_size:v("tsize"),correct_radius:v("trad"),correct_skus:v("tsk"),comment:v("tcm"),parsed:LASTP}'''),
]

FILES = ['app.py','src/engine.py','src/training.py','src/materials_mapping.py','src/hybrid_search.py','src/llm_client.py','src/ui.py','src/clarification_advisor.py']
for f in FILES:
    if not os.path.exists(f):
        sys.exit('Не найден ' + f + ' — запускайте из корня репозитория')
    if not os.path.exists(f + '.v8.bak'):
        shutil.copy(f, f + '.v8.bak')
open('src/iso1832.py','w',encoding='utf-8').write(ISO_SRC)
s = open('src/materials_mapping.py',encoding='utf-8').read()
open('src/materials_mapping.py','w',encoding='utf-8').write(s[:s.index('def detect_insert_shape')] + MM_TAIL)
s = open('src/engine.py',encoding='utf-8').read()
if 'from src import iso1832' not in s:
    m = re.search(r'^from src\.materials_mapping import', s, re.M)
    s = s[:m.start()] + 'from src import iso1832\n' + s[m.start():]
    open('src/engine.py','w',encoding='utf-8').write(s)
for path, old, new in EDITS:
    s = open(path,encoding='utf-8').read()
    n = s.count(old)
    if n != 1:
        sys.exit(f'ОШИБКА в {path}: якорь встречается {n} раз (нужен 1): {old[:70]!r}. Восстановите файлы из *.v8.bak')
    open(path,'w',encoding='utf-8').write(s.replace(old, new))
for f in FILES + ['src/iso1832.py']:
    py_compile.compile(f, doraise=True)
print('Готово: v9 применена. Перезапустите run.bat.')
print('LLM по умолчанию выключен (ADVISOR_DISABLE_LLM=1). Включить: ADVISOR_DISABLE_LLM=0 + рабочий ключ.')