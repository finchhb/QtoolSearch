          "correct_iso", "correct_operation", "correct_shape", "correct_size", "correct_radius",
          "correct_skus", "comment", "status", "rules_added"]
SHAPE_OK = set("ABCDEFGHKLMOPRSTVW")'''),
    ('src/training.py', '''def add_example(query: str, correct_iso: str = "", correct_operation: str = "", correct_skus: str = "", comment: str = "",
                parser: Optional[Dict[str, Any]] = None) -> Dict[str, str]:''', '''def add_example(query: str, correct_iso: str = "", correct_operation: str = "", correct_skus: str = "", comment: str = "",
                parser: Optional[Dict[str, Any]] = None, correct_shape: str = "", correct_size: str = "",
                correct_radius: str = "") -> Dict[str, str]:'''),
    ('src/training.py', '''        "correct_iso": iso if iso in ISO_OK else "", "correct_operation": op if op in OP_OK else "",''', '''        "correct_iso": iso if iso in ISO_OK else "", "correct_operation": op if op in OP_OK else "",
        "correct_shape": (correct_shape or "").strip().upper() if (correct_shape or "").strip().upper() in SHAPE_OK else "",
        "correct_size": (correct_size or "").strip().zfill(2) if (correct_size or "").strip().isdigit() and len((correct_size or "").strip()) <= 2 else "",
        "correct_radius": (correct_radius or "").strip().replace(",", ".") if re.fullmatch(r"\\d+(?:[.,]\\d+)?", (correct_radius or "").strip()) else "",'''),
    ('src/training.py', '''        rows = [r for r in _read() if r["status"] != "rejected" and (r["correct_iso"] or r["correct_operation"] or r["correct_skus"])]''', '''        rows = [r for r in _read() if r["status"] != "rejected" and (r["correct_iso"] or r["correct_operation"] or r["correct_skus"] or r["correct_shape"] or r["correct_size"] or r["correct_radius"])]'''),
    ('app.py', '''MAX_QUERY_LEN = 500''', '''MAX_QUERY_LEN = 4000'''),
    ('app.py', '''INSERT_CODE_RE = re.compile(r"\\b[CWTDSVR][NCTBPEFG][MGU][A-Z]\\s?\\d{4,6}\\b")''', '''INSERT_CODE_RE = re.compile(r"\\b[ABCDEFGHKLMOPRSTVW][ABCDEGFNP][ACEFGHJKLMNU][NRFAMGWTQUBHCJX]\\s?\\d{2}(?:T\\d|\\d{2})\\d{2}\\b")'''),
    ('app.py', '''    if words > 8 or INSERT_CODE_RE.search(q.upper()) or re.search(r"аналог|замен|кросс|вместо", q.lower()):''', '''    if words > 8 or "\\n" in q or INSERT_CODE_RE.search(q.upper()) or re.search(r"аналог|замен|кросс|вместо", q.lower()):'''),
    ('app.py', '''                ex = training.add_example(q, str(body.get("correct_iso", "")), str(body.get("correct_operation", "")),
                                          str(body.get("correct_skus", "")), str(body.get("comment", "")), parsed)
                if not (ex["correct_iso"] or ex["correct_operation"] or ex["correct_skus"] or ex["comment"]):''', '''                ex = training.add_example(q, str(body.get("correct_iso", "")), str(body.get("correct_operation", "")),
                                          str(body.get("correct_skus", "")), str(body.get("comment", "")), parsed,
