            text += "\\n\\n> 💡 Возможно, вы имели в виду: " + ", ".join(f"`{c}`" for c in tool_res["did_you_mean"][:5])'''),
    ('src/engine.py', '''                "shape": args.get("insert_shape") or "", "size": args.get("size_code") or "", "code": args.get("insert_iso_code") or "",''', '''                "shape": args.get("insert_shape") or "", "size": args.get("size_code") or "", "code": args.get("insert_iso_code") or "",
                "radius": args.get("corner_radius_mm"),'''),
    ('src/clarification_advisor.py', '''        has_iso_code = bool(re.search(r'\\b[CWTDSVR][NCTB][MG]\\b', query.upper())) or bool(shape)''', '''        has_iso_code = bool(re.search(r'\\b[ABCDEFGHKLMOPRSTVW][ABCDEGFNP][ACEFGHJKLMNU][NRFAMGWTQUBHCJX](\\s?\\d|\\b)', query.upper())) or bool(shape)'''),
