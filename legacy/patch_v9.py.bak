# -*- coding: utf-8 -*-
"""patch_v9.py — QtoolSearch v8.4 -> v9.
Положить iso1832.py и patch_v9.py в корень репозитория, запустить: python patch_v9.py
Делает бэкапы *.v8.bak. Парсер ISO 1832 без LLM, русские формы/размеры, многострочный поиск,
нечёткий поиск кодов, геометрия+размер+радиус в окне обучения."""
import os, re, shutil, sys, py_compile
os.chdir(os.path.dirname(os.path.abspath(__file__)))
if not os.path.exists('iso1832.py'):
    sys.exit('Положите iso1832.py в корень репозитория рядом с patch_v9.py')
ISO_SRC = open('iso1832.py', encoding='utf-8').read()

MM_TAIL = '''def detect_insert_shape(text: str) -> str:
    """Форма пластины: код ISO или русские слова (ромб/треугольник/квадрат/тригон/...)."""
    from src import iso1832
    return iso1832.detect_shape(text)[0]


def detect_clearance_angle(text: str) -> str:
    """Задний угол: из кода ISO или явного указания (с границами чисел, без ложных '0°' внутри '80°')."""
    from src import iso1832
    return iso1832.detect_clearance(text)


def detect_size_code(text: str) -> str:
    """Код размера: из кода ISO, 'размер 16', 'треугольник 16', '1204', 'N мм' (длина кромки по ГОСТ)."""
    from src import iso1832
    shape = iso1832.detect_shape(text)[0]
    return iso1832.detect_size(text, shape).get("size_code") or ""


def detect_corner_radius(text: str) -> Optional[float]:
    """Радиус вершины: из кода ISO, 'радиус 0,8', 'r0.8', 'R08'."""
    from src import iso1832
    return iso1832.detect_radius(text)
'''

SO = '<option value="">— не менять —</option><option value="C">C — ромб 80°</option><option value="D">D — ромб 55°</option><option value="V">V — ромб 35°</option><option value="E">E — ромб 75°</option><option value="M">M — ромб 86°</option><option value="T">T — треугольник 60°</option><option value="W">W — тригон 80°</option><option value="S">S — квадрат 90°</option><option value="R">R — круглая</option><option value="H">H — шестигранник 120°</option><option value="O">O — восьмигранник</option><option value="P">P — пятигранник</option><option value="L">L — прямоугольная</option><option value="A">A — параллелограмм 85°</option><option value="B">B — параллелограмм 82°</option><option value="K">K — параллелограмм 55°</option>'
RO = '<option value="">— не менять —</option><option>0.2</option><option>0.4</option><option>0.8</option><option>1.2</option><option>1.6</option><option>2.4</option>'
OPL = '''const OP_OPT = '<option value="">— не менять —</option><option value="finishing">чистовая</option><option value="semi_finishing">получистовая</option><option value="roughing">черновая</option>';'''
ADM = '''<div><label>Правильный вид обработки</label><select id="top"><option value="">— не менять —</option><option value="finishing">чистовая</option><option value="semi_finishing">получистовая</option><option value="roughing">черновая</option></select></div></div>'''

EDITS = [
    ('src/engine.py', '''        iso_code_m = re.search(r"(?<![A-Z0-9])([CWTDSVR][NCTBPEFG][MGU][A-Z])\\s?([0-9][0-9A-Z]{0,5})?(?![A-Z])", user_query.upper())''', '''        det = iso1832.detect_all(user_query)'''),
    ('src/engine.py', '''            "insert_iso_code": ((iso_code_m.group(1) + (iso_code_m.group(2) or "")).replace(" ", "")) if iso_code_m else None,
            "insert_shape": detect_insert_shape(user_query) or None,
            "clearance_angle": detect_clearance_angle(user_query) or None,
            "size_code": detect_size_code(user_query) or None,
            "corner_radius_mm": detect_corner_radius(user_query),''', '''            "insert_iso_code": det["code"] or None,
            "insert_shape": det["shape"] or None,
            "clearance_angle": det["clearance"] or None,
            "size_code": det["size_code"] or None,
            "corner_radius_mm": det["radius"],'''),
    ('src/engine.py', '''    def process_query(self, user_query: str, chat_history: Optional[List[Dict[str, Any]]] = None, force_local: bool = False) -> Dict[str, Any]:
        res = self.process_query_autonomous(user_query, allow_review=not force_local)''', '''    def _process_multi(self, positions: List[Dict[str, Any]], allow_review: bool) -> Dict[str, Any]:
        """Несколько позиций в одном запросе: каждая ищется отдельно, ответ объединяется."""
        texts, all_prods, steps, first = [], [], [], None
        seen = set()
        for i, pos in enumerate(positions, 1):
            r = self.process_query_autonomous(pos["text"], allow_review=allow_review)
            if first is None:
                first = r
            qty = f" — {pos['qty']} шт" if pos.get("qty") else ""
            texts.append(f"## Позиция {i}: {pos['text']}{qty}\\n\\n{r.get('response_text', '')}")
            for pr in (r.get("tool_result") or {}).get("products") or []:
                if pr.get("sku") not in seen:
                    seen.add(pr.get("sku"))
                    all_prods.append(pr)
            steps.extend(r.get("tool_steps") or [])
        merged = dict(first)
        merged.update({"decision": "multi_position", "response_text": "\\n\\n---\\n\\n".join(texts),
                       "tool_result": {**(first.get("tool_result") or {}), "products": all_prods[:30]},
                       "tool_steps": steps, "positions": positions})
        return merged

    def process_query(self, user_query: str, chat_history: Optional[List[Dict[str, Any]]] = None, force_local: bool = False) -> Dict[str, Any]:
        allow_review = (not force_local) and os.environ.get("ADVISOR_DISABLE_LLM", "1") != "1"
        positions = iso1832.split_positions(user_query)
        if len(positions) > 1:
            return self._process_multi(positions, allow_review)
        res = self.process_query_autonomous(user_query, allow_review=allow_review)'''),
    ('src/engine.py', '''            if example["correct_operation"]:
                search_args["operation"] = example["correct_operation"]''', '''            if example["correct_operation"]:
                search_args["operation"] = example["correct_operation"]
            if example.get("correct_shape"):
                search_args["insert_shape"] = example["correct_shape"]
            if example.get("correct_size"):
